{
  "name": "web-app-qwerty-4-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "yarn generate:middleware-envs",
    "dev": "cross-env TEST=true next dev --turbopack",
    "dev:test": "cross-env TEST=true NEXT_PUBLIC_STREAM=false next dev",
    "prebuild": "yarn generate:middleware-envs",
    "build": "dotenv next build",
    "prebuild:test": "yarn generate:middleware-envs",
    "build:test": "cross-env TEST=true NEXT_PUBLIC_STREAM=false next build",
    "start": "dotenv next start",
    "generate:middleware-envs": "node middleware-envs-generator.mjs",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "next lint --no-cache",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "cypress:headless": "cross-env TEST=true npx cypress run --e2e",
    "jest": "jest --watch",
    "jest:coverage": "jest --coverage",
    "test": "concurrently \"yarn jest\" \"yarn cypress\"",
    "coverage": "yarn nyc report --reporter=text-summary",
    "coverage:merge": "istanbul-merge --out coverage/summary/coverage-final.json coverage/cypress/coverage-final.json coverage/jest/coverage-final.json && nyc report --reporter=lcov -t coverage/summary --report-dir coverage/summary --check-coverage false",
    "test:coverage": "yarn cypress:headless && yarn jest:coverage && yarn coverage:merge",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@sk-web-gui/ai": "^4.5.0",
    "@sk-web-gui/core": "^4.6.0",
    "@sk-web-gui/next": "^1.2.2",
    "@sk-web-gui/react": "^3.1.0",
    "@sk-web-gui/segmentedcontrol": "^1.1.0",
    "axios": "^1.18.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.1",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^1.18.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "next": "^15.5.19",
    "next-i18n-router": "^5.5.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^16.6.6",
    "sass": "^1.101.0",
    "sharp": "^0.35.1",
    "underscore.string": "^3.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/underscore.string": "^0.0.41",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.17.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "envalid": "^8.2.0",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-react-refresh": "^0.5.3",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-merge": "^2.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^14.0.0",
    "prettier": "^3.8.4",
    "swagger-typescript-api": "13.12.2",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ]
}
